# The app connects via Neon's serverless (WebSocket) driver, not raw TCP —
# on Neon, prefer the pooled connection string (the "-pooler" host) so it
# routes through pgbouncer rather than opening a dedicated compute connection
# per request.
DATABASE_URL="postgresql://selflearning:selflearning@localhost:5432/selflearning?schema=public"

# Set this to enable AI feedback on the Practice page (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional — defaults to claude-opus-5
ANTHROPIC_MODEL=

# Required in production — signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In development, an insecure fallback is used if unset (sessions won't
# survive a restart) and a warning is logged.
AUTH_SESSION_SECRET=

# Email (magic-link login) — https://resend.com. If unset, magic links are
# logged to the server console instead of sent (dev mode).
RESEND_API_KEY=
EMAIL_FROM="Self Learning <onboarding@resend.dev>"

# SMS OTP login — https://www.twilio.com/docs/verify (create a Verify
# Service, no phone number purchase needed). If unset, OTP codes are logged
# to the server console instead of sent (dev mode; in-memory, single process
# only — doesn't work across serverless invocations).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Shared rate-limit store — https://upstash.com (free tier). If unset, rate
# limiting is disabled (fails open) with a one-time console warning.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
